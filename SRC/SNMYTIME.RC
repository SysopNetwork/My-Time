/*  26.07.29.4 11:04PM
 *  SNMYTIME.RC - Windows version resource for the My Time DLL.
 *  Keep FILEVERSION / PRODUCTVERSION and the strings below in step with
 *  MYT_VERSION (SNMYTIME.H) and CHANGELOG.MD on every release.             */

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Sysop Network"
            VALUE "FileDescription",  "My Time - The Major BBS v10 module"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "SNMYTIME"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Sysop Network"
            VALUE "OriginalFilename", "SNMYTIME.DLL"
            VALUE "ProductName",      "My Time"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
